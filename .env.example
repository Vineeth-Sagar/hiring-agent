# Default model to use (must exist in providers.json).
# Ollama examples: "gemma4:latest", "qwen3:4b", "mistral:7b"
# Gemini examples: "gemini-2.5-pro", "gemini-2.5-flash"
# NOTE: on Vercel (or any host without a local Ollama server) this MUST be a
# hosted model, e.g. gemini-2.5-flash.
DEFAULT_MODEL=gemma4:latest

# API keys — only needed for providers whose api_key_env is set in providers.json.
GEMINI_API_KEY=your_gemini_api_key_here

# Set to "false" on read-only / serverless hosts (e.g. Vercel) so the app never
# tries to write cache/ or resume_evaluations_*.csv. Defaults to "true" locally.
DEVELOPMENT_MODE=true

# Set to "false" to skip the automatic GitHub profile enrichment step (faster,
# avoids short function timeouts and the optional GITHUB_TOKEN). Defaults "true".
ENABLE_GITHUB_ENRICHMENT=true

# Optional: raises GitHub API rate limits (60/hr -> 5000/hr) when enrichment is on.
# GITHUB_TOKEN=
